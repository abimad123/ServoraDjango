# Servora Environment Configuration Example
# Copy this file to .env and configure local development variables.
# NEVER commit production secrets, keys, or real credentials.

# Django Settings
SECRET_KEY=django-insecure-servora-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Payment Gateway Configuration (Test / Sandbox Mode)
# In development, leave blank to use Servora's built-in TestGatewayAdapter simulation
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
